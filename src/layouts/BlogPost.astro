---
import type { CollectionEntry } from "astro:content";
import SiteLayout from "./SiteLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
type Props = CollectionEntry<"blog">["data"];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<SiteLayout title={`${title} — Brandon Walker`} description={description}>
  <article class="container article-page">
    <header class="page-heading">
      <p class="eyebrow">
        <FormattedDate date={pubDate} />
        {updatedDate && (
          <span>
            {" "}
            · Updated <FormattedDate date={updatedDate} />
          </span>
        )}
      </p>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    {heroImage && (
      <img
        src={heroImage}
        alt=""
        width="1200"
        height="600"
        class="article-image"
      />
    )}
    <div class="prose">
      <slot />
    </div>
    <a class="text-link" href="/blog">
      ← All notes
    </a>
  </article>
</SiteLayout>
<style>
  .article-page {
    max-width: 850px;
    padding-bottom: 80px;
  }
  .article-image {
    width: 100%;
    border-radius: 5px;
    margin-bottom: 40px;
  }
  .prose {
    color: var(--muted);
    font-size: 16px;
    line-height: 1.9;
  }
  .prose :global(h2),
  .prose :global(h3) {
    color: var(--text);
    margin: 35px 0 20px;
    line-height: 1.2;
  }
  .prose :global(h2) {
    font-size: 32px;
  }
  .prose :global(h3) {
    font-size: 25px;
  }
  .prose :global(a) {
    color: var(--mint);
    text-decoration: underline;
  }
  .prose :global(pre) {
    padding: 20px;
    overflow: auto;
    border-radius: 5px;
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--mint);
    margin: 25px 0;
    padding-left: 25px;
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px;
    border: 1px solid var(--line);
  }
  .prose :global(img) {
    border-radius: 5px;
  }
</style>
