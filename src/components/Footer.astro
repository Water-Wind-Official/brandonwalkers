---
import Icon from "./Icon.astro";
---

<footer class="site-footer container">
  <div class="footer-top">
    <a class="footer-signature" href="/">
      Brandon Walker<span class="mint">.</span>
    </a>
    <p>
      Made of curiosity.
      <br />
      Built for what’s next.
    </p>
    <a class="back-top" href="#top">
      Back to the surface <span>↑</span>
    </a>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Brandon Walker</span>
    <div>
      <a href="/interests">Off the clock</a>
      <a href="/donate">Support my work</a>
      <a
        href="https://github.com/Water-Wind-Official"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub <Icon name="diagonal" size={12} />
      </a>
    </div>
    <button class="motion-toggle" aria-pressed="false" hidden>
      <Icon name="pause" size={13} />
      <span>Pause motion</span>
    </button>
  </div>
</footer>
