---
<header class="site-header">
  <nav class="top-nav">
    <a href="/" class="brand">Brandon Walker</a>
    <div class="nav-links">
      <a href="#work">Work</a>
      <a href="#experience">Experience</a>
      <a href="#resume">Resume</a>
      <a href="/socials">Socials</a>
      <a href="https://indigo-kaylil-55.tiiny.site/Resume.pdf" target="_blank" rel="noopener noreferrer">Resume PDF</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px);
    background: rgba(7, 11, 23, 0.72);
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .top-nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #e2e8f0;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-links a {
    color: rgba(226, 232, 240, 0.82);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: #c4b5fd;
  }

  @media (max-width: 640px) {
    .top-nav {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav-links {
      justify-content: flex-start;
      gap: 0.7rem 1rem;
    }
  }
</style>