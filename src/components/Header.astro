---
import Icon from "./Icon.astro";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/work", label: "Work" },
  { href: "/about", label: "Connect" },
  { href: "/resume", label: "Experience" },
];
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-header">
  <nav class="container navigation" aria-label="Main navigation">
    <a href="/" class="brand" aria-label="Brandon Walker home">
      <span class="brand-mark">
        <Icon name="star" size={28} />
      </span>
      <span>
        BRANDON WALKER
        <span class="brand-sub">DEVELOPER & DIGITAL EXPLORER</span>
      </span>
    </a>
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label="Open navigation"
    >
      <span></span>
      <span></span>
    </button>
    <div class="nav-links" id="main-nav">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/about"
        class="nav-contact"
        aria-current={path === "/about" ? "page" : undefined}
      >
        Let’s connect <Icon name="diagonal" size={15} />
      </a>
    </div>
  </nav>
</header>
