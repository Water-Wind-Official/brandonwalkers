---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
import WaveDivider from "../components/WaveDivider.astro";
import ContactSection from "../components/ContactSection.astro";
import { socials } from "../data/portfolio";
---

<SiteLayout
  title="Connect — Brandon Walker"
  description="Get in touch with Brandon Walker for opportunities and collaborations, or find his work and communities across the web."
>
  <section class="page-heading container">
    <p class="eyebrow">
      <span class="status-dot"></span> TRANSMISSIONS WELCOME
    </p>
    <h1>
      Different orbits.
      <br />
      <span class="tide-accent">Same human.</span>
    </h1>
    <p>
      Have a project in mind, a role to fill, or something interesting to share?
      Here’s where to find me.
    </p>
  </section>
  <section class="page-section container" aria-label="Ways to connect">
    <div class="social-grid">
      {socials.map((social) => (
        <a
          class="social-card"
          href={social.href}
          target={social.href.startsWith("https") ? "_blank" : undefined}
          rel={
            social.href.startsWith("https") ? "noopener noreferrer" : undefined
          }
        >
          <span class="social-symbol" aria-hidden="true">
            {social.symbol}
          </span>
          <Icon name="diagonal" size={23} />
          <h2>{social.name}</h2>
          <strong>{social.handle}</strong>
          <p>{social.description}</p>
        </a>
      ))}
    </div>
    <div class="social-tools">
      <a href="tel:+19127228884">Prefer a call? (912) 722-8884 ↗</a>
      <a class="text-link" href="/work">
        Explore all projects <Icon name="diagonal" size={16} />
      </a>
    </div>
  </section>
  <WaveDivider />
  <ContactSection />
</SiteLayout>
