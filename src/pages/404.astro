---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
---

<SiteLayout
  title="Lost in space — Brandon Walker"
  description="This corner of the universe hasn’t been mapped yet. Find your way back to Brandon Walker’s portfolio."
>
  <section class="container error-page">
    <p class="eyebrow mint">404 / UNCHARTED TERRITORY</p>
    <h1>
      A little too far
      <br />
      into <span class="tide-accent">hyperspace.</span>
    </h1>
    <p>This page doesn’t exist. Let’s find a familiar orbit.</p>
    <a class="button button-mint" href="/">
      Back to Earth <Icon name="arrow" size={17} />
    </a>
  </section>
</SiteLayout>
