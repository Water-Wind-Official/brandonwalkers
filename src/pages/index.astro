		<script>
		  let particlesInitialized = false;

		  function initializeParticles() {
		    if (particlesInitialized) return;

		    if (typeof window.particlesJS === 'undefined') {
		      return false;
		    }

		    const container = document.getElementById('particles-js');
		    if (!container) {
		      return false;
		    }

		    try {
		      particlesJS('particles-js', {
		        particles: {
		          number: { value: 75, density: { enable: true, value_area: 900 } },
		          color: { value: '#8b5cf6' },
		          shape: { type: 'circle' },
		          opacity: {
		            value: 0.45,
		            random: true,
		            anim: { enable: true, speed: 1, opacity_min: 0.18, sync: false }
		          },
		          size: {
		            value: 2.5,
		            random: true,
		            anim: { enable: true, speed: 18, size_min: 1, sync: false }
		          },
		          line_linked: {
		            enable: true,
		            distance: 160,
		            color: '#8b5cf6',
		            opacity: 0.28,
		            width: 1
		          },
		          move: {
		            enable: true,
		            speed: 2.2,
		            direction: 'none',
		            random: true,
		            straight: false,
		            out_mode: 'out',
		            bounce: false
		          }
		        },
		        interactivity: {
		          detect_on: 'canvas',
		          events: {
		            onhover: { enable: true, mode: 'grab' },
		            onclick: { enable: true, mode: 'push' },
		            resize: true
		          },
		          modes: {
		            grab: { distance: 180, line_linked: { opacity: 1 } },
		            push: { particles_nb: 3 }
		          }
		        },
		        retina_detect: true
		      });
		      particlesInitialized = true;
		      return true;
		    } catch (error) {
		      console.error('Error initializing particles:', error);
		      return false;
		    }
		  }

		  function tryInitialize() {
		    if (initializeParticles()) {
		      return;
		    }
		    setTimeout(() => {
		      if (!particlesInitialized) {
		        initializeParticles();
		      }
		    }, 150);
		  }

		  document.addEventListener('DOMContentLoaded', () => {
		    const script = document.getElementById('particles-script');
		    if (script) {
		      if (script.readyState === 'complete' || script.readyState === 'loaded') {
		        tryInitialize();
		      } else {
		        script.onload = tryInitialize;
		        script.onerror = () => {
		          console.error('Failed to load particles.js - background visual may not work');
		        };
		      }
		    }
		    tryInitialize();
		  });

		  window.addEventListener('load', () => {
		    if (!particlesInitialized) {
		      tryInitialize();
		    }

		    const sections = document.querySelectorAll('.content-section');
		    const observer = new IntersectionObserver((entries) => {
		      entries.forEach((entry) => {
		        if (entry.isIntersecting) {
		          entry.target.classList.add('visible');
		          observer.unobserve(entry.target);
		        }
		      });
		    }, { threshold: 0.12 });

		    sections.forEach((section) => observer.observe(section));
		  });
		</script>
	</body>
