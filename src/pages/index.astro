---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
import OceanScene from "../components/OceanScene.astro";
import WaveDivider from "../components/WaveDivider.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactSection from "../components/ContactSection.astro";
import { projects } from "../data/portfolio";
import { RESUME_URL } from "../consts";
---

<SiteLayout class="ocean-home">
  <section class="ocean-hero" aria-labelledby="hero-title">
    <OceanScene />
    <div class="ocean-hero-content container">
      <p class="eyebrow hero-kicker">
        <span></span> A DEVELOPER. AN EXPLORER. A DIFFERENT PERSPECTIVE.{" "}
        <span></span>
      </p>
      <h1 id="hero-title">
        <span>Beyond</span>
        <span class="hero-title-depth">the surface.</span>
      </h1>
      <p class="ocean-intro">
        I’m <strong>Brandon Walker.</strong> I turn curiosity into digital
        <br class="desktop-break" /> experiences with a world of possibility
        beneath them.
      </p>
      <div class="ocean-actions">
        <a class="button button-mint" href="#work">
          Explore my work <Icon name="diagonal" size={18} />
        </a>
        <a class="button button-outline" href={RESUME_URL} download>
          Download résumé <Icon name="down" size={17} />
        </a>
      </div>
    </div>
    <div class="ocean-hero-rail container">
      <a href="#work" class="ocean-scroll">
        <span class="scroll-circle">↓</span>
        <span>
          SCROLL TO
          <br />
          GO DEEPER
        </span>
      </a>
      <span class="ocean-location">
        <span class="status-dot"></span> GEORGIA, EARTH · OPEN TO WHAT’S NEXT
      </span>
      <button class="hyperspace-button" hidden>
        <Icon name="star" size={15} />
        <span>Ride the wave</span>
      </button>
    </div>
    <div class="hero-depth-marker" aria-hidden="true">
      <span>CREATIVE DEPTH</span>
      <i></i>
      <span>∞</span>
    </div>
  </section>
  <div class="ocean-current-band">
    <div class="container expertise-strip" aria-label="Areas of focus">
      <span>WEB DEVELOPMENT</span>
      <Icon name="star" size={17} />
      <span>DIGITAL UX</span>
      <Icon name="star" size={17} />
      <span>QUALITY ASSURANCE</span>
      <Icon name="star" size={17} />
      <span>WORLD BUILDING</span>
    </div>
  </div>
  <section
    class="section container selected-work"
    id="work"
    aria-labelledby="work-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow section-number">
          <span>01</span> / SELECTED EXPLORATIONS
        </p>
        <h2 id="work-title">
          Made of curiosity.
          <br />
          <span class="tide-accent">Built to be experienced.</span>
        </h2>
      </div>
      <div class="section-heading-aside">
        <p>
          From useful little tools to
          <br />
          entire worlds to get lost in.
        </p>
        <a class="text-link" href="/work">
          Explore all {projects.length} projects{" "}
          <Icon name="diagonal" size={18} />
        </a>
      </div>
    </div>
    <div class="project-grid featured-projects">
      {projects.slice(0, 3).map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>
  <WaveDivider label="CURIOSITY IS A CURRENT. FOLLOW IT." />
  <section class="ocean-manifesto container" aria-labelledby="manifesto-title">
    <p class="eyebrow section-number">
      <Icon name="star" size={20} /> THE THREAD THROUGH EVERYTHING
    </p>
    <h2 id="manifesto-title">
      The best digital spaces
      <br />
      make you <span class="tide-accent">feel something.</span>
    </h2>
    <p>
      A sense of discovery. A moment of clarity. A reason to stay.
      <br class="desktop-break" /> That’s what I’m here to build.
    </p>
  </section>
  <section
    class="section container about-section"
    id="about"
    aria-labelledby="about-title"
  >
    <div class="about-portrait">
      <img
        src="/images/brandon-walker.webp"
        width="800"
        height="1067"
        alt="Brandon Walker"
        loading="lazy"
      />
      <div class="portrait-caption">
        <span>BRANDON WALKER / THE HUMAN PART</span>
        <Icon name="star" size={20} />
      </div>
      <span class="portrait-stamp" aria-hidden="true">
        ALWAYS
        <br />
        EXPLORING ↗
      </span>
    </div>
    <div class="about-copy">
      <p class="eyebrow section-number">
        <span>02</span> / BEHIND THE SCREEN
      </p>
      <h2 id="about-title">
        An open mind.
        <br />
        <span class="tide-accent">An endless horizon.</span>
      </h2>
      <p>
        I’ve always been drawn to spaces that bring people together. Sometimes
        that’s a website. Sometimes it’s an imagined world. Always, it’s about
        the experience.
      </p>
      <p>
        I’m studying Information Technology at Middle Georgia State University,
        specializing in digital UX, and working in quality assurance at TELUS
        Digital. Years of leading people taught me to build with care.
      </p>
      <a class="text-link" href="/about">
        Meet the person behind the work <Icon name="diagonal" size={18} />
      </a>
      <div class="about-facts">
        <div>
          <strong>
            100<span>+</span>
          </strong>
          <span>COLLEGE CREDITS</span>
        </div>
        <div>
          <strong>
            14<span>+</span>
          </strong>
          <span>CREW MEMBERS TRAINED & MANAGED</span>
        </div>
        <div>
          <strong>∞</strong>
          <span>CURIOSITY</span>
        </div>
      </div>
    </div>
  </section>
  <WaveDivider flip />
  <section
    class="section container experience-section"
    id="experience"
    aria-labelledby="experience-title"
  >
    <div class="section-heading" id="resume">
      <div>
        <p class="eyebrow section-number">
          <span>03</span> / THE JOURNEY SO FAR
        </p>
        <h2 id="experience-title">
          Different experiences.
          <br />
          <span class="tide-accent">One forward current.</span>
        </h2>
      </div>
      <a class="text-link" href="/resume">
        My full résumé <Icon name="diagonal" size={18} />
      </a>
    </div>
    <div class="experience-row">
      <span class="experience-date">FEB 2024 — PRESENT</span>
      <div>
        <h3>Quality Assurance Specialist</h3>
        <p>TELUS Digital</p>
      </div>
      <span class="experience-tag">QUALITY & CARE</span>
      <Icon name="star" size={24} />
    </div>
    <div class="experience-row">
      <span class="experience-date">JUL 2020 — MAR 2025</span>
      <div>
        <h3>Assistant Store Manager</h3>
        <p>Zoner’s Pizza</p>
      </div>
      <span class="experience-tag">PEOPLE & OPERATIONS</span>
      <Icon name="star" size={24} />
    </div>
    <div class="experience-row">
      <span class="experience-date">MAR 2024 — PRESENT</span>
      <div>
        <h3>
          Bachelor’s in Information Technology{" "}
          <span class="in-progress">In progress</span>
        </h3>
        <p>Middle Georgia State University</p>
      </div>
      <span class="experience-tag">ALWAYS LEARNING</span>
      <Icon name="star" size={24} />
    </div>
  </section>
  <ContactSection />
</SiteLayout>
