---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
import ContactSection from "../components/ContactSection.astro";
import { socials } from "../data/portfolio";
---

<SiteLayout
  title="Connect — Brandon Walker"
  description="Connect with Brandon Walker on email, GitHub, LinkedIn, Discord, YouTube, and more."
>
  <section class="page-heading container">
    <p class="eyebrow">
      <span class="status-dot"></span> LET’S BUILD SOMETHING
    </p>
    <h1>
      Connect.
      <br />
      <span class="tide-accent">Start the conversation.</span>
    </h1>
    <p>
      I’m open to product work, digital builds, collaborations, and the kind of
      opportunities that need someone who can think clearly and ship well.
    </p>
  </section>

  <section class="page-section container" aria-label="Ways to connect">
    <div class="connect-intro">
      <div>
        <h2>Ways to reach me</h2>
        <p>
          Whether you’re looking for a developer, a collaborator, a teammate, or a
          point of contact for a new idea, I’m easy to reach.
        </p>
      </div>
      <div class="connect-quick-links">
        <a href="mailto:blwaterwind@gmail.com">Email me</a>
        <a href="/resume">View experience</a>
        <a href="/work">Explore projects</a>
      </div>
    </div>

    <div class="social-grid">
      {socials.map((social) => (
        <a
          class="social-card"
          href={social.href}
          target={social.href.startsWith("https") ? "_blank" : undefined}
          rel={
            social.href.startsWith("https") ? "noopener noreferrer" : undefined
          }
        >
          <span class="social-symbol" aria-hidden="true">
            {social.symbol}
          </span>
          <Icon name="diagonal" size={23} />
          <h2>{social.name}</h2>
          <strong>{social.handle}</strong>
          <p>{social.description}</p>
        </a>
      ))}
    </div>
  </section>

  <ContactSection />
</SiteLayout>
