---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
import WaveDivider from "../components/WaveDivider.astro";
import ContactSection from "../components/ContactSection.astro";
---

<SiteLayout
  title="About — Brandon Walker"
  description="Meet Brandon Walker: a developer, digital UX student, quality assurance specialist, and curious creator from Georgia."
>
  <section class="page-heading container">
    <p class="eyebrow">02 / A HUMAN BEHIND THE PIXELS</p>
    <h1>
      Rooted on Earth.
      <br />
      <span class="tide-accent">Thinking beyond it.</span>
    </h1>
    <p>
      I’m Brandon Walker. I create digital spaces, care about the people using
      them, and like to leave room for a little wonder.
    </p>
  </section>
  <section class="page-section container">
    <div class="about-page-grid">
      <div class="about-story">
        <h2>
          Always building.
          <br />
          Always becoming.
        </h2>
        <p>
          I was born in Waycross, Georgia, in 1997. My curiosity lives somewhere
          between software, the natural world, and the way people experience the
          spaces around them.
        </p>
        <p>
          Today, I’m a third-year Information Technology student at Middle
          Georgia State University, with more than 100 credits completed and a
          focus on digital UX. Alongside my studies, I work as a Quality
          Assurance Specialist at TELUS Digital.
        </p>
        <p>
          Before that, I trained and managed a crew of more than 14 people at
          Zoner’s Pizza. Busy shifts taught me how to listen, keep things
          moving, and make complicated work feel manageable. Those lessons come
          with me when I’m building for the web.
        </p>
        <p>
          I enjoy taking an idea from an empty page to a living digital space.
          My work spans web development, Cloudflare deployment, Android apps,
          and game worlds. I’m open to employment opportunities anywhere in the
          United States.
        </p>
        <div class="skill-list">
          <span>HTML / CSS</span>
          <span>Python</span>
          <span>Digital UX</span>
          <span>Cloudflare</span>
          <span>Quality assurance</span>
          <span>Project management</span>
          <span>Customer service</span>
        </div>
        <a class="text-link" href="/resume">
          Explore my experience <Icon name="diagonal" size={17} />
        </a>
      </div>
      <div class="about-portrait">
        <img
          src="/images/brandon-walker.webp"
          alt="Brandon Walker"
          width="800"
          height="1067"
        />
        <span class="portrait-stamp" aria-hidden="true">
          HELLO
          <br />
          FROM EARTH
        </span>
        <div class="portrait-caption">
          <span>BRANDON WALKER / GEORGIA</span>
          <Icon name="star" size={20} />
        </div>
      </div>
    </div>
    <div class="principles">
      <div class="principle">
        <Icon name="globe" size={28} />
        <h3>Think in experiences.</h3>
        <p>
          A useful digital space starts with understanding the people who will
          spend time in it.
        </p>
      </div>
      <div class="principle">
        <Icon name="code" size={28} />
        <h3>Care for the details.</h3>
        <p>
          From quality assurance to customer support, I’ve learned that the
          small things shape the whole experience.
        </p>
      </div>
      <div class="principle">
        <Icon name="star" size={28} />
        <h3>Keep exploring.</h3>
        <p>
          New tools, unfamiliar worlds, another perspective. There’s always
          something worth learning.
        </p>
      </div>
    </div>
  </section>
  <WaveDivider />
  <section class="container section">
    <div class="section-heading">
      <div>
        <p class="eyebrow section-number">BEYOND THE SCREEN</p>
        <h2>
          There’s a whole world <span class="tide-accent">out there.</span>
        </h2>
      </div>
    </div>
    <p class="section-intro">
      Oceans, big cities, philosophy, and a soft spot for cats.
    </p>
    <a class="text-link" href="/interests">
      Meet me off the clock <Icon name="diagonal" size={18} />
    </a>
  </section>
  <ContactSection />
</SiteLayout>
